# Copia a .env para ejecución directa. Con Docker, usa las variables de compose.yaml.
HOST=127.0.0.1
PORT=3000
DATA_DIR=./data
# Activa ambas opciones detrás de un único proxy HTTPS que controles.
COOKIE_SECURE=0
TRUST_PROXY=0
# Si se deja vacío, solo se admiten peticiones del mismo host.
APP_ORIGIN=
UPLOAD_QUOTA_MB=2048
# Partidas simultáneas ejecutadas por Chromium del servidor (1 a 8).
MAX_SERVER_GAMES=2
# Opcional: ruta de los navegadores instalados. Por defecto .cache/server-browsers.
# PLAYWRIGHT_BROWSERS_PATH=
